# WeatherGPT Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.

# --- Weather Provider ---
# Open-Meteo is free and requires no API key.
WEATHER_API_KEY=your_weather_api_key_here

# WeatherAPI.com — fallback provider when Open-Meteo is rate-limited.
# Free tier: 1M calls/month. Get your key at: https://www.weatherapi.com/
WEATHERAPI_KEY=your_weatherapi_key_here

# --- AI Provider (Google Gemini) ---
# Used for the /api/chat endpoint.
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# --- App Settings ---
APP_NAME=WeatherGPT
DEBUG=false

# --- MySQL Database ---
# MySQL database connection string.
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/mausam_mitra
